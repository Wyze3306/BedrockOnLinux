From 4c433d7f0177f38c1f935b0bb28ae49c25e699ff Mon Sep 17 00:00:00 2001
From: BedrockOnLinux <dev@bedrockonlinux.invalid>
Date: Mon, 16 Nov 2026 17:25:38 +0700
Subject: [PATCH] xodus-cli: add xbl-ticket subcommand for Windows Xbox Live
 SISU auth

---
 crates/xodus-cli/src/commands.rs            |   1 +
 crates/xodus-cli/src/commands/xbl_ticket.rs | 168 ++++++++++++++++++++
 crates/xodus-cli/src/main.rs                |   8 +
 3 files changed, 177 insertions(+)
 create mode 100644 crates/xodus-cli/src/commands/xbl_ticket.rs

diff --git a/crates/xodus-cli/src/commands.rs b/crates/xodus-cli/src/commands.rs
index dc75156..a289e02 100644
--- a/crates/xodus-cli/src/commands.rs
+++ b/crates/xodus-cli/src/commands.rs
@@ -9,3 +9,4 @@ pub mod logout;
 pub mod run;
 pub mod splicense;
 pub mod streaming;
+pub mod xbl_ticket;
diff --git a/crates/xodus-cli/src/commands/xbl_ticket.rs b/crates/xodus-cli/src/commands/xbl_ticket.rs
new file mode 100644
index 0000000..ef4cf02
--- /dev/null
+++ b/crates/xodus-cli/src/commands/xbl_ticket.rs
@@ -0,0 +1,168 @@
+use std::process::ExitCode;
+
+use xodus::api::live::RSTError;
+use xodus::models::live::ExchangeUserTokenOutcome;
+use xodus::models::secrets::{LegacyToken, Token};
+use xodus::models::soap;
+use xodus::tokens::TokenManager;
+use xodus::tokens::session;
+
+const HOST_APP: &str = "{d6d5a677-0872-4ab0-9442-bb792fce85c5}";
+const DEFAULT_CLIENT_ID: &str = "0000000040159362";
+
+pub async fn run(
+    client: &reqwest::Client,
+    tokens: &TokenManager,
+    client_id: Option<String>,
+) -> ExitCode {
+    let client_id = client_id.unwrap_or_else(|| DEFAULT_CLIENT_ID.to_string());
+    match fetch_tickets(client, tokens, &client_id).await {
+        Ok(json) => {
+            println!("{json}");
+            ExitCode::SUCCESS
+        }
+        Err(err) => {
+            eprintln!("{err}");
+            ExitCode::FAILURE
+        }
+    }
+}
+
+async fn exchange_device_rps(
+    client: &reqwest::Client,
+    dev_token: LegacyToken,
+) -> Result<soap::RequestSecurityTokenResponse, RSTError> {
+    xodus::api::live::exchange_device_token(
+        client,
+        dev_token,
+        "{28C08266-F973-4AE6-FFE4-409B249F138F}".to_string(),
+        "scope=service::user.auth.xboxlive.com::MBI_SSL&api-version=2.0".to_owned(),
+        Some(soap::PolicyReference::token_broker()),
+    )
+    .await
+}
+
+async fn fetch_tickets(
+    client: &reqwest::Client,
+    tokens: &TokenManager,
+    client_id: &str,
+) -> Result<String, String> {
+    let dev_token = match tokens.get_device_sts_token() {
+        Ok(Token::Legacy(t)) => t,
+        Ok(_) => return Err("Invalid device STS token".to_string()),
+        Err(err) => return Err(format!("not logged in: device token missing ({err})")),
+    };
+    let user = tokens
+        .get_user()
+        .map_err(|err| format!("not logged in: user missing ({err})"))?;
+    let legacy = match tokens.get_user_sts_token() {
+        Ok(Token::Legacy(t)) => t,
+        Ok(_) => return Err("Unsupported user STS token".to_string()),
+        Err(err) => return Err(format!("not logged in: user STS token missing ({err})")),
+    };
+
+    let (dev_token, device_rps_resp) =
+        match exchange_device_rps(client, dev_token.clone()).await {
+            Ok(resp) => (dev_token, resp),
+            Err(err) if !matches!(err, RSTError::Request(_)) => {
+                tracing::warn!("reauthenticating device session after {err}");
+                xodus::tokens::device::reauthenticate_device_session(client, tokens).await;
+                let dev_token = match tokens.get_device_sts_token() {
+                    Ok(Token::Legacy(t)) => t,
+                    Ok(_) => return Err("Invalid device STS token".to_string()),
+                    Err(err) => return Err(format!("device token missing after reauth ({err})")),
+                };
+                let resp = exchange_device_rps(client, dev_token.clone())
+                    .await
+                    .map_err(|e| format!("device token exchange failed: {e}"))?;
+                (dev_token, resp)
+            }
+            Err(err) => return Err(format!("device token exchange failed: {err}")),
+        };
+
+    let Token::Compact(device_rps) = device_rps_resp.into() else {
+        return Err("Unsupported device RPS token".to_string());
+    };
+
+    let legacy = if session::is_ending(&legacy, chrono::Utc::now()) {
+        match session::renew_account_session(
+            client,
+            tokens,
+            legacy.clone(),
+            user.username.clone(),
+            dev_token.clone(),
+            HOST_APP,
+        )
+        .await
+        {
+            Ok(renewed) => renewed,
+            Err(err) => {
+                tracing::warn!("could not renew Microsoft account session: {err}");
+                legacy
+            }
+        }
+    } else {
+        legacy
+    };
+
+    let outcome = xodus::api::live::exchange_user_token(
+        client,
+        legacy,
+        user.username,
+        dev_token,
+        None,
+        Some("Silent".to_string()),
+        client_id.to_string(),
+        &[
+            (
+                format!("scope=xboxlive.signin&api-version=2.0&clientid={client_id}"),
+                Some(soap::PolicyReference::token_broker()),
+            ),
+            ("http://Passport.NET/tb".to_string(), None),
+        ],
+    )
+    .await
+    .map_err(|err| format!("exchange_user_token failed: {err}"))?;
+
+    let mut tokens_out = match outcome {
+        ExchangeUserTokenOutcome::Fault(fault) => {
+            return Err(format!("login.live.com returned fault: {fault:?}"));
+        }
+        ExchangeUserTokenOutcome::Issued(
+            soap::BodyContent::RequestSecurityTokenResponseCollection(collection),
+        ) => collection.security_tokens,
+        ExchangeUserTokenOutcome::Issued(soap::BodyContent::RequestSecurityTokenResponse(t)) => {
+            vec![*t]
+        }
+        _ => return Err("Unexpected RST2 response".to_string()),
+    };
+
+    if tokens_out.len() > 1
+        && let Some(sts) = tokens_out.pop()
+    {
+        let address = sts.applies_to.endpoint_reference.address.clone();
+        let sts: Token = sts.into();
+        let address = if let Token::Legacy(ref l) = sts {
+            l.key_name.clone().unwrap_or(address)
+        } else {
+            address
+        };
+        if let Err(err) = tokens.save_user_token(address, sts) {
+            tracing::warn!("Failed to persist refreshed STS token: {err}");
+        }
+    }
+
+    let Some(first) = tokens_out.into_iter().next() else {
+        return Err("No user token in RST2 response".to_string());
+    };
+    let Token::Compact(user_token) = first.into() else {
+        return Err("Unsupported user token format (expected Compact)".to_string());
+    };
+
+    Ok(serde_json::json!({
+        "user_token": user_token,
+        "device_rps": device_rps,
+    })
+    .to_string())
+}
+
diff --git a/crates/xodus-cli/src/main.rs b/crates/xodus-cli/src/main.rs
index cf0db1d..e26e7a1 100644
--- a/crates/xodus-cli/src/main.rs
+++ b/crates/xodus-cli/src/main.rs
@@ -89,6 +89,11 @@ enum SubCommand {
     SpLicense {
         block: String,
     },
+    #[command(about = "Fetch Xbox Live RPS tickets for SISU authentication")]
+    XblTicket {
+        #[arg(long)]
+        client_id: Option<String>,
+    },
 }
 
 #[derive(Subcommand)]
@@ -241,6 +246,9 @@ async fn main() -> ExitCode {
             ClepAction::Decrypt { data } => commands::clep::decrypt(data),
         },
         SubCommand::SpLicense { block } => commands::splicense::run(block),
+        SubCommand::XblTicket { client_id } => {
+            commands::xbl_ticket::run(&client, &tokens, client_id).await
+        }
     };
 
     xodus::secrets::destroy_secrets();
-- 
