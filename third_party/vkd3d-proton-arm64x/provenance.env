# The cross file is upstream's build-arm64x.txt (d5f57cebf2, 2026-09-22),
# which postdates v3.0.1.
VKD3D_ARM64X_CROSS_FILE_SHA256='a78be32451ef99f5ffaf5cff3241a5bd9a153266d80d9f2d96038e6b38380683'
# Upstream 20c0ab2095 (hybrid_patchable on the command queue vtable), backported
