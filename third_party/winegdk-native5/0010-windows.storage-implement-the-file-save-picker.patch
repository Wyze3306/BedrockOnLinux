+        WindowsDeleteString( picker->default_extension );
+        WindowsDeleteString( picker->commit_button_text );
+        WindowsDeleteString( picker->settings_identifier );
+        picker->cs.DebugInfo->Spare[0] = 0;
+        DeleteCriticalSection( &picker->cs );
+        free( picker );
