diff --git a/dlls/windows.storage/savepicker.c b/dlls/windows.storage/savepicker.c
new file mode 100644
index 0000000..81d1ee8
--- /dev/null
+++ b/dlls/windows.storage/savepicker.c
@@ -0,0 +1,1313 @@
+/* WinRT Windows.Storage.Pickers.FileSavePicker implementation.
+ *
+ * Copyright 2026 BedrockOnLinux contributors
+ *
+ * This library is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation; either
+ * version 2.1 of the License, or (at your option) any later version.
+ */
+
+#define WINDOWS_STORAGE_UWP_PICKERS
+#include "private.h"
+#include "roapi.h"
+
+WINE_DEFAULT_DEBUG_CHANNEL(storage);
+
+/* main.c instantiates the GUIDs of every header private.h pulls in, and this
+ * is the one header it cannot include (see private.h), so the two this file
+ * uses are instantiated here, with the values widl computes for them. */
+const GUID IID___x_ABI_CWindows_CStorage_CPickers_CIFileSavePicker =
+    {0x3286ffcb, 0x617f, 0x4cc5, {0xaf, 0x6a, 0xb3, 0xfd, 0xf2, 0x9a, 0xd1, 0x45}};
+const GUID IID___FIMap_2_HSTRING___FIVector_1_HSTRING =
+    {0xe475ca9d, 0x6afb, 0x5992, {0x99, 0x3e, 0x53, 0xe6, 0xef, 0x7a, 0x9e, 0xcd}};
+
+#define ASYNC_CLOSED ((AsyncStatus)4)
+
+/* A desktop COM interface rather than a WinRT one, which no header here
+ * declares: a desktop app hands the picker its owner window through it. */
+typedef struct IInitializeWithWindow IInitializeWithWindow;
+
+typedef struct IInitializeWithWindowVtbl
+{
+    HRESULT (WINAPI *QueryInterface)( IInitializeWithWindow *iface, REFIID iid, void **out );
+    ULONG (WINAPI *AddRef)( IInitializeWithWindow *iface );
+    ULONG (WINAPI *Release)( IInitializeWithWindow *iface );
+    HRESULT (WINAPI *Initialize)( IInitializeWithWindow *iface, HWND hwnd );
+} IInitializeWithWindowVtbl;
+
+struct IInitializeWithWindow
+{
+    const IInitializeWithWindowVtbl *lpVtbl;
+};
+
+static const IID IID_IInitializeWithWindow =
+    {0x3e68d4bd, 0x7135, 0x4d10, {0x80, 0x18, 0x9f, 0xb6, 0xd9, 0xf3, 0x3f, 0xa1}};
+
+/* Windows.Storage.StorageFile is served by windows.storage.applicationdata.dll,
+ * and windows.storage.idl only forward-declares its statics interface. Only
+ * the slots up to GetFileFromPathAsync are used. */
+struct storage_file_statics;
+
+struct storage_file_statics_vtbl
+{
+    HRESULT (WINAPI *QueryInterface)( struct storage_file_statics *iface, REFIID iid, void **out );
+    ULONG (WINAPI *AddRef)( struct storage_file_statics *iface );
+    ULONG (WINAPI *Release)( struct storage_file_statics *iface );
+    HRESULT (WINAPI *GetIids)( struct storage_file_statics *iface, ULONG *count, IID **iids );
+    HRESULT (WINAPI *GetRuntimeClassName)( struct storage_file_statics *iface, HSTRING *name );
+    HRESULT (WINAPI *GetTrustLevel)( struct storage_file_statics *iface, TrustLevel *level );
+    HRESULT (WINAPI *GetFileFromPathAsync)( struct storage_file_statics *iface, HSTRING path,
+                                            IAsyncOperation_StorageFile **operation );
+};
+
+struct storage_file_statics
+{
+    const struct storage_file_statics_vtbl *lpVtbl;
+};
+
+static const IID storage_file_statics_iid =
+    {0x5984c710, 0xdaf2, 0x43c8, {0x8b, 0xb4, 0xa4, 0xd3, 0xea, 0xcf, 0xd0, 0x3f}};
+
+struct type_choice
+{
+    HSTRING name;
+    IVector_HSTRING *extensions;
+};
+
+struct type_choices
+{
+    IMap_HSTRING_IVector_HSTRING IMap_HSTRING_IVector_HSTRING_iface;
+    LONG ref;
+    CRITICAL_SECTION cs;
+    struct type_choice *items;
+    UINT32 size;
+    UINT32 capacity;
+};
+
+struct file_save_picker
+{
+    IFileSavePicker IFileSavePicker_iface;
+    IInitializeWithWindow IInitializeWithWindow_iface;
+    LONG ref;
+    CRITICAL_SECTION cs;
+    HWND hwnd;
+    PickerLocationId location;
+    HSTRING settings_identifier;
+    HSTRING commit_button_text;
+    HSTRING default_extension;
+    HSTRING suggested_file_name;
+    IStorageFile *suggested_save_file;
+    struct type_choices *choices;
+};
+
+struct save_operation
+{
+    IAsyncOperation_StorageFile IAsyncOperation_StorageFile_iface;
+    IAsyncInfo IAsyncInfo_iface;
+    LONG ref;
+    CRITICAL_SECTION cs;
+    BOOL handler_set;
+    AsyncStatus status;
+    HRESULT error;
+    IAsyncOperationCompletedHandler_StorageFile *handler;
+    IStorageFile *result;
+};
+
+struct file_save_picker_factory
+{
+    IActivationFactory IActivationFactory_iface;
+    LONG ref;
+};
+
+static HRESULT copy_iids( ULONG *iid_count, IID **iids, UINT count, const IID *const *values )
+{
+    UINT i;
+
+    if (!iid_count || !iids) return E_POINTER;
+    *iid_count = 0;
+    if (!(*iids = CoTaskMemAlloc( count * sizeof(**iids) ))) return E_OUTOFMEMORY;
+    for (i = 0; i < count; ++i) (*iids)[i] = *values[i];
+    *iid_count = count;
+    return S_OK;
+}
+
+static HRESULT class_name( const WCHAR *name, HSTRING *value )
+{
+    if (!value) return E_POINTER;
+    return WindowsCreateString( name, wcslen( name ), value );
+}
+
+static HRESULT base_trust( TrustLevel *level )
+{
+    if (!level) return E_POINTER;
+    *level = BaseTrust;
+    return S_OK;
+}
+
+static BOOL same_string( HSTRING a, HSTRING b )
+{
+    INT32 order = 1;
+    return SUCCEEDED(WindowsCompareStringOrdinal( a, b, &order )) && !order;
+}
+
+/* Windows.Foundation.Collections.IMap<HSTRING, IVector<HSTRING> *>: the
+ * FileTypeChoices map. The caller fills it and the dialog reads it back, in
+ * the order the choices were inserted. */
+
+static inline struct type_choices *choices_from_iface( IMap_HSTRING_IVector_HSTRING *iface )
+{
+    return CONTAINING_RECORD( iface, struct type_choices, IMap_HSTRING_IVector_HSTRING_iface );
+}
+
+static HRESULT WINAPI choices_QueryInterface( IMap_HSTRING_IVector_HSTRING *iface, REFIID iid, void **out )
+{
+    struct type_choices *choices = choices_from_iface( iface );
+
+    TRACE( "iface %p, iid %s, out %p.\n", iface, debugstr_guid( iid ), out );
+
+    if (!out) return E_POINTER;
+    if (IsEqualGUID( iid, &IID_IUnknown ) || IsEqualGUID( iid, &IID_IInspectable ) ||
+        IsEqualGUID( iid, &IID_IAgileObject ) || IsEqualGUID( iid, &IID_IMap_HSTRING_IVector_HSTRING ))
+    {
+        IInspectable_AddRef( (IInspectable *)(*out = &choices->IMap_HSTRING_IVector_HSTRING_iface) );
+        return S_OK;
+    }
+
+    FIXME( "%s not implemented, returning E_NOINTERFACE.\n", debugstr_guid( iid ) );
+    *out = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG WINAPI choices_AddRef( IMap_HSTRING_IVector_HSTRING *iface )
+{
+    return InterlockedIncrement( &choices_from_iface( iface )->ref );
+}
+
+static void choices_clear( struct type_choices *choices )
+{
+    UINT32 i;
+
+    for (i = 0; i < choices->size; ++i)
+    {
+        WindowsDeleteString( choices->items[i].name );
+        IVector_HSTRING_Release( choices->items[i].extensions );
+    }
+    choices->size = 0;
+}
+
+static ULONG WINAPI choices_Release( IMap_HSTRING_IVector_HSTRING *iface )
+{
+    struct type_choices *choices = choices_from_iface( iface );
+    ULONG ref = InterlockedDecrement( &choices->ref );
+
+    if (!ref)
+    {
+        choices_clear( choices );
+        free( choices->items );
+        choices->cs.DebugInfo->Spare[0] = 0;
+        DeleteCriticalSection( &choices->cs );
+        free( choices );
+    }
+    return ref;
+}
+
+static HRESULT WINAPI choices_GetIids( IMap_HSTRING_IVector_HSTRING *iface, ULONG *count, IID **iids )
+{
+    static const IID *values[] = {&IID_IMap_HSTRING_IVector_HSTRING};
+    return copy_iids( count, iids, ARRAY_SIZE(values), values );
+}
+
+static HRESULT WINAPI choices_GetRuntimeClassName( IMap_HSTRING_IVector_HSTRING *iface, HSTRING *name )
+{
+    return class_name( L"Windows.Foundation.Collections.IMap`2<String, "
+                       L"Windows.Foundation.Collections.IVector`1<String>>", name );
+}
+
+static HRESULT WINAPI choices_GetTrustLevel( IMap_HSTRING_IVector_HSTRING *iface, TrustLevel *level )
+{
+    return base_trust( level );
+}
+
+static struct type_choice *choices_find( struct type_choices *choices, HSTRING key )
+{
+    UINT32 i;
+
+    for (i = 0; i < choices->size; ++i)
+        if (same_string( choices->items[i].name, key )) return &choices->items[i];
+    return NULL;
+}
+
+static HRESULT WINAPI choices_Lookup( IMap_HSTRING_IVector_HSTRING *iface, HSTRING key, IVector_HSTRING **value )
+{
+    struct type_choices *choices = choices_from_iface( iface );
+    struct type_choice *choice;
+    HRESULT hr = S_OK;
+
+    TRACE( "iface %p, key %s, value %p.\n", iface, debugstr_hstring( key ), value );
+
+    if (!value) return E_POINTER;
+    *value = NULL;
+    EnterCriticalSection( &choices->cs );
+    if ((choice = choices_find( choices, key )))
+        IVector_HSTRING_AddRef( *value = choice->extensions );
+    else
+        hr = E_BOUNDS;
+    LeaveCriticalSection( &choices->cs );
+    return hr;
+}
+
+static HRESULT WINAPI choices_get_Size( IMap_HSTRING_IVector_HSTRING *iface, UINT32 *size )
+{
+    struct type_choices *choices = choices_from_iface( iface );
+
+    if (!size) return E_POINTER;
+    EnterCriticalSection( &choices->cs );
+    *size = choices->size;
+    LeaveCriticalSection( &choices->cs );
+    return S_OK;
+}
+
+static HRESULT WINAPI choices_HasKey( IMap_HSTRING_IVector_HSTRING *iface, HSTRING key, boolean *found )
+{
+    struct type_choices *choices = choices_from_iface( iface );
+
+    if (!found) return E_POINTER;
+    EnterCriticalSection( &choices->cs );
+    *found = choices_find( choices, key ) != NULL;
+    LeaveCriticalSection( &choices->cs );
+    return S_OK;
+}
+
+static HRESULT WINAPI choices_GetView( IMap_HSTRING_IVector_HSTRING *iface, IMapView_HSTRING_IVector_HSTRING **view )
+{
+    FIXME( "iface %p, view %p stub!\n", iface, view );
+    if (view) *view = NULL;
+    return E_NOTIMPL;
+}
+
+static HRESULT WINAPI choices_Insert( IMap_HSTRING_IVector_HSTRING *iface, HSTRING key, IVector_HSTRING *value,
+                                      boolean *replaced )
+{
+    struct type_choices *choices = choices_from_iface( iface );
+    struct type_choice *choice, *items;
+    HSTRING name;
+    HRESULT hr;
+
+    TRACE( "iface %p, key %s, value %p, replaced %p.\n", iface, debugstr_hstring( key ), value, replaced );
+
+    if (!value || !replaced) return E_POINTER;
+    EnterCriticalSection( &choices->cs );
+    if ((choice = choices_find( choices, key )))
+    {
+        IVector_HSTRING_AddRef( value );
+        IVector_HSTRING_Release( choice->extensions );
+        choice->extensions = value;
+        *replaced = TRUE;
+        LeaveCriticalSection( &choices->cs );
+        return S_OK;
+    }
+    if (choices->size == choices->capacity)
+    {
+        UINT32 capacity = max( 4, choices->capacity * 2 );
+        if (!(items = realloc( choices->items, capacity * sizeof(*items) )))
+        {
+            LeaveCriticalSection( &choices->cs );
+            return E_OUTOFMEMORY;
+        }
+        choices->items = items;
+        choices->capacity = capacity;
+    }
+    if (FAILED(hr = WindowsDuplicateString( key, &name )))
+    {
+        LeaveCriticalSection( &choices->cs );
+        return hr;
+    }
+    choices->items[choices->size].name = name;
+    IVector_HSTRING_AddRef( choices->items[choices->size].extensions = value );
+    choices->size++;
+    *replaced = FALSE;
+    LeaveCriticalSection( &choices->cs );
+    return S_OK;
+}
+
+static HRESULT WINAPI choices_Remove( IMap_HSTRING_IVector_HSTRING *iface, HSTRING key )
+{
+    struct type_choices *choices = choices_from_iface( iface );
+    struct type_choice *choice;
+    HRESULT hr = S_OK;
+
+    EnterCriticalSection( &choices->cs );
+    if ((choice = choices_find( choices, key )))
+    {
+        UINT32 index = choice - choices->items;
+        WindowsDeleteString( choice->name );
+        IVector_HSTRING_Release( choice->extensions );
+        memmove( choice, choice + 1, (choices->size - index - 1) * sizeof(*choice) );
+        choices->size--;
+    }
+    else hr = E_BOUNDS;
+    LeaveCriticalSection( &choices->cs );
+    return hr;
+}
+
+static HRESULT WINAPI choices_Clear( IMap_HSTRING_IVector_HSTRING *iface )
+{
+    struct type_choices *choices = choices_from_iface( iface );
+
+    EnterCriticalSection( &choices->cs );
+    choices_clear( choices );
+    LeaveCriticalSection( &choices->cs );
+    return S_OK;
+}
+
+static const IMap_HSTRING_IVector_HSTRINGVtbl choices_vtbl =
+{
+    choices_QueryInterface,
+    choices_AddRef,
+    choices_Release,
+    choices_GetIids,
+    choices_GetRuntimeClassName,
+    choices_GetTrustLevel,
+    choices_Lookup,
+    choices_get_Size,
+    choices_HasKey,
+    choices_GetView,
+    choices_Insert,
+    choices_Remove,
+    choices_Clear,
+};
+
+static HRESULT type_choices_create( struct type_choices **out )
+{
+    struct type_choices *choices;
+
+    if (!(choices = calloc( 1, sizeof(*choices) ))) return E_OUTOFMEMORY;
+    choices->IMap_HSTRING_IVector_HSTRING_iface.lpVtbl = &choices_vtbl;
+    choices->ref = 1;
+    InitializeCriticalSectionEx( &choices->cs, 0, RTL_CRITICAL_SECTION_FLAG_FORCE_DEBUG_INFO );
+    choices->cs.DebugInfo->Spare[0] = (DWORD_PTR)(__FILE__ ": type_choices.cs");
+    *out = choices;
+    return S_OK;
+}
+
+/* Windows.Foundation.IAsyncOperation<Windows.Storage.StorageFile *>. The
+ * dialog is modal and has been answered by the time the operation exists, so
+ * it is created complete, and a completion handler runs as soon as it is set:
+ * C++/WinRT installs one and waits on nothing else. A dismissed dialog
+ * completes with no file, as on Windows. */
+
+static inline struct save_operation *operation_from_iface( IAsyncOperation_StorageFile *iface )
+{
+    return CONTAINING_RECORD( iface, struct save_operation, IAsyncOperation_StorageFile_iface );
+}
+
+static inline struct save_operation *operation_from_info( IAsyncInfo *iface )
+{
+    return CONTAINING_RECORD( iface, struct save_operation, IAsyncInfo_iface );
+}
+
+static HRESULT operation_query_interface( struct save_operation *operation, REFIID iid, void **out )
+{
+    if (!out) return E_POINTER;
+    *out = NULL;
+    if (IsEqualGUID( iid, &IID_IUnknown ) || IsEqualGUID( iid, &IID_IInspectable ) ||
+        IsEqualGUID( iid, &IID_IAgileObject ) || IsEqualGUID( iid, &IID_IAsyncOperation_StorageFile ))
+        *out = &operation->IAsyncOperation_StorageFile_iface;
+    else if (IsEqualGUID( iid, &IID_IAsyncInfo ))
+        *out = &operation->IAsyncInfo_iface;
+    else
+    {
+        FIXME( "%s not implemented, returning E_NOINTERFACE.\n", debugstr_guid( iid ) );
+        return E_NOINTERFACE;
+    }
+    InterlockedIncrement( &operation->ref );
+    return S_OK;
+}
+
+static ULONG operation_add_ref( struct save_operation *operation )
+{
+    return InterlockedIncrement( &operation->ref );
+}
+
+static ULONG operation_release( struct save_operation *operation )
+{
+    ULONG ref = InterlockedDecrement( &operation->ref );
+
+    if (!ref)
+    {
+        if (operation->handler) IAsyncOperationCompletedHandler_StorageFile_Release( operation->handler );
+        if (operation->result) IStorageFile_Release( operation->result );
+        operation->cs.DebugInfo->Spare[0] = 0;
+        DeleteCriticalSection( &operation->cs );
+        free( operation );
+    }
+    return ref;
+}
+
+static HRESULT WINAPI operation_QueryInterface( IAsyncOperation_StorageFile *iface, REFIID iid, void **out )
+{
+    return operation_query_interface( operation_from_iface( iface ), iid, out );
+}
+
+static ULONG WINAPI operation_AddRef( IAsyncOperation_StorageFile *iface )
+{
+    return operation_add_ref( operation_from_iface( iface ) );
+}
+
+static ULONG WINAPI operation_Release( IAsyncOperation_StorageFile *iface )
+{
+    return operation_release( operation_from_iface( iface ) );
+}
+
+static HRESULT WINAPI operation_GetIids( IAsyncOperation_StorageFile *iface, ULONG *count, IID **iids )
+{
+    static const IID *values[] = {&IID_IAsyncOperation_StorageFile, &IID_IAsyncInfo};
+    return copy_iids( count, iids, ARRAY_SIZE(values), values );
+}
+
+static HRESULT WINAPI operation_GetRuntimeClassName( IAsyncOperation_StorageFile *iface, HSTRING *name )
+{
+    if (!name) return E_POINTER;
+    *name = NULL;
+    return S_OK;
+}
+
+static HRESULT WINAPI operation_GetTrustLevel( IAsyncOperation_StorageFile *iface, TrustLevel *level )
+{
+    return base_trust( level );
+}
+
+static HRESULT WINAPI operation_put_Completed( IAsyncOperation_StorageFile *iface,
+                                               IAsyncOperationCompletedHandler_StorageFile *handler )
+{
+    struct save_operation *operation = operation_from_iface( iface );
+    AsyncStatus status;
+    HRESULT hr = S_OK;
+
+    TRACE( "iface %p, handler %p.\n", iface, handler );
+
+    EnterCriticalSection( &operation->cs );
+    if (operation->status == ASYNC_CLOSED)
+        hr = E_ILLEGAL_METHOD_CALL;
+    else if (operation->handler_set)
+        hr = E_ILLEGAL_DELEGATE_ASSIGNMENT;
+    else
+        operation->handler_set = TRUE;
+    status = operation->status;
+    LeaveCriticalSection( &operation->cs );
+
+    if (hr != S_OK || !handler) return hr;
+    operation_add_ref( operation );
+    IAsyncOperationCompletedHandler_StorageFile_Invoke( handler, iface, status );
+    operation_release( operation );
+    return S_OK;
+}
