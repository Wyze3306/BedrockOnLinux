+/* ".mcstructure" and "mcstructure" both become "*.mcstructure". */
+static SIZE_T append_pattern( WCHAR *buffer, HSTRING extension )
+{
+    const WCHAR *value;
+    UINT32 length;
+    SIZE_T written = 0;
+
+    value = WindowsGetStringRawBuffer( extension, &length );
+    if (length && value[0] == '*') { value++; length--; }
+    if (buffer) buffer[written] = '*';
+    written++;
+    if (!length || value[0] != '.')
+    {
+        if (buffer) buffer[written] = '.';
+        written++;
+    }
+    if (buffer) memcpy( buffer + written, value, length * sizeof(WCHAR) );
+    return written + length;
+}
+
+/* "*.a;*.b" for one choice, NUL-terminated, or NULL when it names no extension. */
+static WCHAR *choice_patterns( IVector_HSTRING *extensions )
+{
+    UINT32 count, i;
+    SIZE_T length = 1;
+    HSTRING extension;
+    WCHAR *patterns, *cursor;
+
+    if (FAILED(IVector_HSTRING_get_Size( extensions, &count )) || !count) return NULL;
+    for (i = 0; i < count; ++i)
+    {
+        if (FAILED(IVector_HSTRING_GetAt( extensions, i, &extension ))) return NULL;
+        length += append_pattern( NULL, extension ) + 1;
+        WindowsDeleteString( extension );
+    }
+    if (!(patterns = calloc( length, sizeof(WCHAR) ))) return NULL;
+    for (i = 0, cursor = patterns; i < count; ++i)
+    {
+        if (FAILED(IVector_HSTRING_GetAt( extensions, i, &extension ))) break;
+        if (cursor + append_pattern( NULL, extension ) + 1 >= patterns + length)
+        {
+            WindowsDeleteString( extension );
+            break;
+        }
+        if (i) *cursor++ = ';';
+        cursor += append_pattern( cursor, extension );
+        WindowsDeleteString( extension );
+    }
+    return patterns;
+}
+
+/* "Name\0*.a;*.b\0...\0\0", one entry per choice in insertion order, or every
+ * file when there is none. A choice without a name is shown by its patterns:
+ * an empty name would read as the end of the list. */
+static WCHAR *build_filter( struct type_choices *choices )
+{
+    static const WCHAR all_files[] = L"All Files\0*.*\0";
+    WCHAR *filter = NULL, *grown, **patterns = NULL;
+    const WCHAR *name;
+    SIZE_T length = 1, used = 0, name_length, patterns_length;
+    UINT32 i, count, length32;
+
+    EnterCriticalSection( &choices->cs );
+    count = choices->size;
+    if (count && (patterns = calloc( count, sizeof(*patterns) )))
+    {
+        for (i = 0; i < count; ++i)
+        {
+            if (!(patterns[i] = choice_patterns( choices->items[i].extensions ))) continue;
+            WindowsGetStringRawBuffer( choices->items[i].name, &length32 );
+            name_length = length32 ? length32 : wcslen( patterns[i] );
+            length += name_length + 1 + wcslen( patterns[i] ) + 1;
+        }
+        if (length > 1 && (filter = calloc( length, sizeof(WCHAR) )))
+        {
+            for (i = 0; i < count; ++i)
+            {
+                if (!patterns[i]) continue;
+                name = WindowsGetStringRawBuffer( choices->items[i].name, &length32 );
+                if (length32) name_length = length32;
+                else name_length = wcslen( name = patterns[i] );
+                patterns_length = wcslen( patterns[i] );
+                memcpy( filter + used, name, name_length * sizeof(WCHAR) );
+                used += name_length + 1;
+                memcpy( filter + used, patterns[i], patterns_length * sizeof(WCHAR) );
+                used += patterns_length + 1;
+            }
+        }
+        for (i = 0; i < count; ++i) free( patterns[i] );
+        free( patterns );
+    }
+    LeaveCriticalSection( &choices->cs );
+
+    if (filter) return filter;
+    if ((grown = malloc( sizeof(all_files) ))) memcpy( grown, all_files, sizeof(all_files) );
+    return grown;
+}
+
+/* The extension GetSaveFileNameW appends when the name typed has none:
+ * DefaultFileExtension, else the first extension of the first choice. */
+static WCHAR *default_extension( struct file_save_picker *picker )
+{
+    HSTRING extension = NULL;
+    const WCHAR *value;
+    UINT32 length, count;
+    WCHAR *copy = NULL;
+
+    if (!WindowsIsStringEmpty( picker->default_extension ))
+        WindowsDuplicateString( picker->default_extension, &extension );
+    else
+    {
+        EnterCriticalSection( &picker->choices->cs );
+        if (picker->choices->size &&
+            SUCCEEDED(IVector_HSTRING_get_Size( picker->choices->items[0].extensions, &count )) && count)
+            IVector_HSTRING_GetAt( picker->choices->items[0].extensions, 0, &extension );
+        LeaveCriticalSection( &picker->choices->cs );
+    }
+    value = WindowsGetStringRawBuffer( extension, &length );
+    while (length && (value[0] == '*' || value[0] == '.')) { value++; length--; }
+    if (length && (copy = calloc( length + 1, sizeof(WCHAR) ))) memcpy( copy, value, length * sizeof(WCHAR) );
+    WindowsDeleteString( extension );
+    return copy;
+}
+
+static void initial_file_name( struct file_save_picker *picker, WCHAR *buffer, UINT32 size )
+{
+    IStorageItem *item;
+    HSTRING path = NULL;
+    const WCHAR *value;
+    UINT32 length;
+
+    buffer[0] = 0;
+    if (picker->suggested_save_file &&
+        SUCCEEDED(IStorageFile_QueryInterface( picker->suggested_save_file, &IID_IStorageItem, (void **)&item )))
+    {
+        IStorageItem_get_Path( item, &path );
+        IStorageItem_Release( item );
+    }
+    if (WindowsIsStringEmpty( path ))
+    {
+        WindowsDeleteString( path );
+        WindowsDuplicateString( picker->suggested_file_name, &path );
+    }
+    value = WindowsGetStringRawBuffer( path, &length );
+    if (length < size)
+    {
+        memcpy( buffer, value, length * sizeof(WCHAR) );
+        buffer[length] = 0;
+    }
+    WindowsDeleteString( path );
+}
+
+/* A picked file exists on Windows, empty if it did not before; an existing
+ * one is left alone until its caller writes to it. */
+static HRESULT storage_file_for_path( const WCHAR *path, IStorageFile **file )
+{
+    struct storage_file_statics *statics = NULL;
+    IAsyncOperation_StorageFile *operation = NULL;
+    HSTRING name = NULL, value = NULL;
+    HANDLE handle;
+    HRESULT hr;
+
+    *file = NULL;
+    handle = CreateFileW( path, GENERIC_WRITE, FILE_SHARE_READ | FILE_SHARE_WRITE | FILE_SHARE_DELETE,
+                          NULL, OPEN_ALWAYS, FILE_ATTRIBUTE_NORMAL, NULL );
+    if (handle == INVALID_HANDLE_VALUE) return HRESULT_FROM_WIN32( GetLastError() );
+    CloseHandle( handle );
+
+    if (FAILED(hr = WindowsCreateString( RuntimeClass_Windows_Storage_StorageFile,
+                                         wcslen( RuntimeClass_Windows_Storage_StorageFile ), &name )))
+        return hr;
+    if (SUCCEEDED(hr = RoGetActivationFactory( name, &storage_file_statics_iid, (void **)&statics )) &&
+        SUCCEEDED(hr = WindowsCreateString( path, wcslen( path ), &value )) &&
+        SUCCEEDED(hr = statics->lpVtbl->GetFileFromPathAsync( statics, value, &operation )))
+        hr = IAsyncOperation_StorageFile_GetResults( operation, file );
+    if (operation) IAsyncOperation_StorageFile_Release( operation );
+    if (statics) statics->lpVtbl->Release( statics );
+    WindowsDeleteString( value );
+    WindowsDeleteString( name );
+    return hr;
+}
+
+static HRESULT show_save_dialog( struct file_save_picker *picker, IStorageFile **file )
+{
+    OPENFILENAMEW dialog = {0};
+    const KNOWNFOLDERID *folder_id;
+    WCHAR *filter, *extension, *path, *initial_dir = NULL;
+    HRESULT hr = S_OK;
+    DWORD error;
+
+    *file = NULL;
+    filter = build_filter( picker->choices );
+    extension = default_extension( picker );
+    if (!filter || !(path = calloc( 32768, sizeof(*path) )))
+    {
+        free( extension );
+        free( filter );
+        return E_OUTOFMEMORY;
+    }
+    initial_file_name( picker, path, 32768 );
+    if ((folder_id = known_folder_from_location( picker->location )))
+        SHGetKnownFolderPath( folder_id, 0, NULL, &initial_dir );
+
+    dialog.lStructSize = sizeof(dialog);
+    dialog.hwndOwner = picker->hwnd;
+    dialog.lpstrFilter = filter;
+    dialog.nFilterIndex = 1;
+    dialog.lpstrFile = path;
+    dialog.nMaxFile = 32768;
+    dialog.lpstrInitialDir = initial_dir;
+    dialog.lpstrDefExt = extension;
+    dialog.Flags = OFN_EXPLORER | OFN_OVERWRITEPROMPT | OFN_PATHMUSTEXIST | OFN_NOCHANGEDIR | OFN_HIDEREADONLY;
+
+    if (GetSaveFileNameW( &dialog ))
+    {
+        TRACE( "picked %s.\n", debugstr_w( path ) );
+        hr = storage_file_for_path( path, file );
+    }
+    else if ((error = CommDlgExtendedError()))
+        hr = HRESULT_FROM_WIN32( error );
+    else
+        TRACE( "dismissed.\n" );
+
+    CoTaskMemFree( initial_dir );
+    free( path );
+    free( extension );
+    free( filter );
+    return hr;
+}
