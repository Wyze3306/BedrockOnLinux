+static HRESULT WINAPI operation_GetResults( IAsyncOperation_StorageFile *iface, IStorageFile **results )
+{
+    struct save_operation *operation = operation_from_iface( iface );
+    HRESULT hr;
+
+    TRACE( "iface %p, results %p.\n", iface, results );
+
+    if (!results) return E_POINTER;
+    *results = NULL;
+    EnterCriticalSection( &operation->cs );
+    if (operation->status == Completed)
+    {
+        if (operation->result) IStorageFile_AddRef( *results = operation->result );
+        hr = S_OK;
+    }
+    else if (operation->status == Error)
+        hr = operation->error;
+    else
+        hr = E_ILLEGAL_METHOD_CALL;
+    LeaveCriticalSection( &operation->cs );
+    return hr;
+}
