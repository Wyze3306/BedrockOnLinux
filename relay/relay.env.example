# /etc/bol-report-relay/relay.env — read by bol-report-relay.service.
# No secret lives in this file: the App's private key is a separate file,
# handed to the service by systemd (LoadCredential, see the unit).

# Where the relay listens. Loopback: the reverse proxy in front does TLS.
BOL_RELAY_LISTEN=127.0.0.1:8787

# The one repository issues are filed on.
BOL_RELAY_REPO=Wyze3306/BedrockOnLinux

# The GitHub App (Settings > Developer settings > GitHub Apps > the app):
# its "App ID", and the number at the end of the URL of its installation on
# the repository (github.com/settings/installations/<this number>).
BOL_RELAY_APP_ID=
BOL_RELAY_INSTALLATION_ID=

# Labels put on each issue, comma separated. They must already exist in the
# repository: the App may write issues, not create labels.
BOL_RELAY_LABELS=user-report

# Limits. A "sender" is one address, remembered only as a salted hash, in
# memory, until the service restarts.
BOL_RELAY_PER_SENDER_HOUR=3
BOL_RELAY_PER_SENDER_DAY=6
BOL_RELAY_TOTAL_DAY=100
BOL_RELAY_ATTEMPTS_HOUR=30
BOL_RELAY_MAX_BYTES=450000

# 1 while a reverse proxy on this machine sets X-Forwarded-For (believed
# only from loopback). 0 if the relay is reached directly.
BOL_RELAY_TRUST_PROXY=1

# Set to 1 to answer "use the browser instead" without filing anything,
# for instance while a flood is dealt with. Then: systemctl restart.
BOL_RELAY_PAUSED=0

# Set to 1 to accept reports and file nothing, to try the installation
# before the App exists. The answer then points at issue 0.
BOL_RELAY_DRY_RUN=0
