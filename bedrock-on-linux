#!/usr/bin/env python3
# SPDX-License-Identifier: MIT
"""Locate the bundled ``bol`` package and run its CLI."""
import os
import sys

_here = os.path.dirname(os.path.realpath(__file__))
for _cand in (_here,
              os.path.join(os.path.dirname(_here), "lib", "bedrock-on-linux")):
    if os.path.isdir(os.path.join(_cand, "bol")):
        sys.path.insert(0, _cand)
        break

try:
    if len(sys.argv) > 1 and sys.argv[1] == "optiscaler":
        from bol.optiscaler import cli_main
        _entry = lambda: cli_main(sys.argv[2:])
    else:
        from bol.optiscaler import bootstrap
        bootstrap()
        from bol.cli import main
        _entry = main
except ModuleNotFoundError:
    sys.exit("BedrockOnLinux: the 'bol' package is missing — reinstall the app "
             "(https://github.com/Wyze3306/BedrockOnLinux).")

if __name__ == "__main__":
    try:
        _entry()
    except KeyboardInterrupt:
        print()
        sys.exit(130)
